{
  "name": "a manual release, a hold and the switch each act at the next scan",
  "covers": [
    "a manual release, a hold and the switch take effect at the next scan; a release waiting on the broker when the board connects is ignored"
  ],
  "about": "A train waits at Left and is granted. A manual release frees the bridge and puts Left Bridge to Stop at the next scan; the train is granted again the scan after. A hold cancels the grant at the next scan, and the train waits until it is unheld. Switching off at the next scan frees the bridge and hands Left Bridge to JMRI's last aspect.",
  "board": {
    "sensors": [
      "Left",
      "Bridge",
      "Right"
    ],
    "masts": {
      "Left Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Right Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Bridge",
          "blocks": [
            "Bridge"
          ],
          "release": {
            "while": {
              "block": "Bridge",
              "is": "clear"
            },
            "for": "3s"
          }
        }
      ],
      "layers": [
        {
          "name": "Gauntlet",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Left",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Left Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Right",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Right Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 6,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 9,
      "expect": {
        "rules": {
          "Gauntlet/1": "active"
        },
        "events": []
      }
    },
    {
      "at": 10,
      "do": [
        {
          "release": "Bridge",
          "via": "button"
        }
      ],
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "manual"
          }
        ],
        "masts": {
          "Left Bridge": "R292"
        },
        "resources": {
          "Bridge": "IDLE"
        },
        "rules": {
          "Gauntlet/1": "waiting"
        }
      }
    },
    {
      "at": 11,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 20,
      "do": [
        {
          "jmri": "Left Bridge",
          "message": "R281; Lit; Held"
        }
      ],
      "expect": {
        "events": [
          {
            "cancel": "Bridge",
            "rule": "Gauntlet/1"
          },
          {
            "release": "Bridge",
            "by": "cancel"
          }
        ],
        "masts": {
          "Left Bridge": "R292"
        },
        "resources": {
          "Bridge": "IDLE"
        },
        "rules": {
          "Gauntlet/1": "waiting"
        }
      }
    },
    {
      "at": 21,
      "expect": {
        "events": [],
        "rules": {
          "Gauntlet/1": "waiting"
        },
        "masts": {
          "Left Bridge": "R292"
        }
      }
    },
    {
      "at": 25,
      "do": [
        {
          "jmri": "Left Bridge",
          "message": "R281; Lit; Unheld"
        }
      ],
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 29,
      "expect": {
        "logic": "on"
      }
    },
    {
      "at": 30,
      "do": [
        {
          "logic": "off"
        }
      ],
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "switch"
          }
        ],
        "logic": "off",
        "resources": {
          "Bridge": "IDLE"
        },
        "masts": {
          "Left Bridge": "R281",
          "Right Bridge": "R292"
        }
      }
    },
    {
      "at": 31,
      "expect": {
        "logic": "off",
        "masts": {
          "Left Bridge": "R281",
          "Right Bridge": "R292"
        }
      }
    }
  ]
}
