{
  "name": "single-line bridge: a train leaving through Right does not clear Right Bridge",
  "covers": [
    "the leaving guard: a departing train does not clear its own mast"
  ],
  "about": "A train from Left crosses and leaves through the Right block while the section is still held, so Right's leaving guard is set. When the section releases with the train still in Right, Right is not granted. Once Right has cleared, a real train arriving there is granted.",
  "board": {
    "sensors": [
      "Left",
      "Bridge",
      "Right"
    ],
    "masts": {
      "Left Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Right Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Bridge",
          "blocks": [
            "Bridge"
          ],
          "release": {
            "while": {
              "block": "Bridge",
              "is": "clear"
            },
            "for": "3s"
          }
        }
      ],
      "layers": [
        {
          "name": "Single line",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Left",
                  "is": "occupied"
                },
                "for": "0.5s",
                "leavingGuard": true
              },
              "checks": [
                {
                  "block": "Right",
                  "is": "clear"
                }
              ],
              "then": {
                "mast": "Left Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Right",
                  "is": "occupied"
                },
                "for": "0.5s",
                "leavingGuard": true
              },
              "checks": [
                {
                  "block": "Left",
                  "is": "clear"
                }
              ],
              "then": {
                "mast": "Right Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 6,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Single line/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 10,
      "do": [
        {
          "sensor": "Bridge",
          "is": "occupied"
        }
      ],
      "expect": {
        "events": [
          {
            "pass": "Bridge",
            "rule": "Single line/1"
          }
        ]
      }
    },
    {
      "at": 12,
      "do": [
        {
          "sensor": "Left",
          "is": "clear"
        }
      ]
    },
    {
      "at": 20,
      "do": [
        {
          "sensor": "Right",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 22,
      "do": [
        {
          "sensor": "Bridge",
          "is": "clear"
        }
      ]
    },
    {
      "at": 25,
      "expect": {
        "rules": {
          "Single line/2": "idle"
        },
        "masts": {
          "Right Bridge": "R292"
        }
      }
    },
    {
      "at": 51,
      "expect": {
        "resources": {
          "Bridge": "PASSED"
        }
      }
    },
    {
      "at": 52,
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "release"
          }
        ],
        "resources": {
          "Bridge": "IDLE"
        },
        "rules": {
          "Single line/2": "idle"
        },
        "masts": {
          "Right Bridge": "R292"
        }
      }
    },
    {
      "at": 53,
      "expect": {
        "events": [],
        "masts": {
          "Right Bridge": "R292"
        }
      }
    },
    {
      "at": 70,
      "do": [
        {
          "sensor": "Right",
          "is": "clear"
        }
      ]
    },
    {
      "at": 80,
      "do": [
        {
          "sensor": "Right",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 84,
      "expect": {
        "rules": {
          "Single line/2": "idle"
        }
      }
    },
    {
      "at": 85,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Single line/2"
          }
        ],
        "masts": {
          "Right Bridge": "R281"
        }
      }
    }
  ]
}
