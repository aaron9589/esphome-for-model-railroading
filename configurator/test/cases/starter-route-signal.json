{
  "name": "route signal: first matching route wins, a moving turnout matches none, and a route that follows the next signal",
  "covers": [
    "route signal: the first row whose turnouts and blocks match wins; a moving turnout matches no row; a row that follows the next mast joins the block signals tumbledown"
  ],
  "about": "Home is a route signal at turnout P1, with three routes in order: P1 closed into Main, following Main 1/2 (a block signal that reads East Home, which CATS drives); P1 thrown with Branch and Branch 2 clear, Medium Clear (R283); P1 thrown with Branch clear, Medium Approach (R286). Advance Approach is used. Masts read the masts ahead as the previous scan wrote them, so Home follows Main 1/2 one scan later. With P1 thrown and both branch blocks clear, routes 2 and 3 both match and route 2, listed first, wins. P1 moving matches no route, so Home shows Stop.",
  "board": {
    "sensors": [
      "Main",
      "Main 2",
      "Branch",
      "Branch 2"
    ],
    "turnouts": [
      "P1"
    ],
    "masts": {
      "Home": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear",
          "R286": "approach",
          "R283": "clear"
        },
        "diverging": [
          "R286",
          "R283"
        ]
      },
      "Main 1/2": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear"
        }
      },
      "East Home": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "layers": [
        {
          "name": "Main",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Main 2",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "mast": "East Home",
                  "is": "diverging"
                },
                {
                  "not": {
                    "mast": "East Home",
                    "is": [
                      "stop",
                      "restricting"
                    ]
                  }
                }
              ],
              "then": {
                "mast": "Main 1/2",
                "aspect": "R285"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main 2",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "mast": "East Home",
                  "is": [
                    "advance",
                    "clear"
                  ]
                }
              ],
              "then": {
                "mast": "Main 1/2",
                "aspect": "R281"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main 2",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "mast": "East Home",
                  "is": "approach"
                }
              ],
              "then": {
                "mast": "Main 1/2",
                "aspect": "ADV_NORM"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main 2",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "mast": "East Home",
                  "is": [
                    "stop",
                    "restricting"
                  ]
                }
              ],
              "then": {
                "mast": "Main 1/2",
                "aspect": "R285"
              }
            }
          ]
        },
        {
          "name": "Home",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Main",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "closed"
                },
                {
                  "mast": "Main 1/2",
                  "is": "diverging"
                },
                {
                  "not": {
                    "mast": "Main 1/2",
                    "is": [
                      "stop",
                      "restricting"
                    ]
                  }
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "R285"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "closed"
                },
                {
                  "mast": "Main 1/2",
                  "is": [
                    "advance",
                    "clear"
                  ]
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "R281"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "closed"
                },
                {
                  "mast": "Main 1/2",
                  "is": "approach"
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "ADV_NORM"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Main",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "closed"
                },
                {
                  "mast": "Main 1/2",
                  "is": [
                    "stop",
                    "restricting"
                  ]
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "R285"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Branch",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "thrown"
                },
                {
                  "block": "Branch 2",
                  "is": "clear"
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "R283"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Branch",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "turnout": "P1",
                  "is": "thrown"
                }
              ],
              "then": {
                "mast": "Home",
                "aspect": "R286"
              }
            }
          ]
        }
      ]
    }
  },
  "start": {
    "jmri": {
      "East Home": "R281; Lit; Unheld"
    }
  },
