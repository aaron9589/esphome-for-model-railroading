{
  "name": "a release waiting on the broker at connect is ignored",
  "covers": [
    "a manual release, a hold and the switch take effect at the next scan; a release waiting on the broker when the board connects is ignored"
  ],
  "about": "A Release THROWN in the first 5 seconds after the board connects (at power-on, and again after a reconnect at 1.2s) was waiting on the broker, so it is ignored and answered with CLOSED. One sent later releases.",
  "board": {
    "sensors": [
      "Left",
      "Bridge",
      "Right"
    ],
    "masts": {
      "Left Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Right Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Bridge",
          "blocks": [
            "Bridge"
          ],
          "release": {
            "while": {
              "block": "Bridge",
              "is": "clear"
            },
            "for": "3s"
          }
        }
      ],
      "layers": [
        {
          "name": "Gauntlet",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Left",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Left Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Right",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Right Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 2,
      "do": [
        {
          "release": "Bridge",
          "via": "mqtt"
        }
      ],
      "expect": {
        "events": [
          {
            "ignored": "release",
            "resource": "Bridge"
          }
        ],
        "publishes": [
          {
            "release": "Bridge",
            "value": "CLOSED"
          }
        ]
      }
    },
    {
      "at": 6,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 10,
      "do": [
        {
          "broker": "disconnected"
        }
      ]
    },
    {
      "at": 12,
      "do": [
        {
          "broker": "connected"
        }
      ],
      "expect": {
        "publishes": [
          {
            "resource": "Bridge",
            "held": "ACTIVE"
          },
          {
            "resource": "Bridge",
            "state": "ACTIVE"
          }
        ]
      }
    },
    {
      "at": 13,
      "do": [
        {
          "release": "Bridge",
          "via": "mqtt"
        }
      ],
      "expect": {
        "events": [
          {
            "ignored": "release",
            "resource": "Bridge"
          }
        ],
        "publishes": [
          {
            "release": "Bridge",
            "value": "CLOSED"
          }
        ],
        "resources": {
          "Bridge": "ACTIVE"
        },
        "masts": {
          "Left Bridge": "R281"
        }
      }
    },
    {
      "at": 70,
      "do": [
        {
          "release": "Bridge",
          "via": "mqtt"
        }
      ],
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "manual"
          }
        ],
        "publishes": [
          {
            "resource": "Bridge",
            "held": "INACTIVE"
          },
          {
            "resource": "Bridge",
            "state": "IDLE"
          },
          {
            "release": "Bridge",
            "value": "CLOSED"
          }
        ],
        "masts": {
          "Left Bridge": "R292"
        }
      }
    },
    {
      "at": 71,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    }
  ]
}
