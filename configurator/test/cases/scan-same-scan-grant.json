{
  "name": "two entrances ask in the same scan: one grant, list order; then the longest waiting wins",
  "covers": [
    "two rules wanting the same resource in one scan: one grant, to the longest waiting, then list order"
  ],
  "about": "Trains arrive at Left and Right together: Left is listed first and is granted, once. While the first train is on the bridge, a second train arrives at Left. Right has waited longer, so Right is granted when the bridge frees, though Left is listed first.",
  "board": {
    "sensors": [
      "Left",
      "Bridge",
      "Right"
    ],
    "masts": {
      "Left Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Right Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Bridge",
          "blocks": [
            "Bridge"
          ],
          "release": {
            "while": {
              "block": "Bridge",
              "is": "clear"
            },
            "for": "3s"
          }
        }
      ],
      "layers": [
        {
          "name": "Gauntlet",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Left",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Left Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Right",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Right Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        },
        {
          "sensor": "Right",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 5,
      "expect": {
        "rules": {
          "Gauntlet/1": "idle",
          "Gauntlet/2": "idle"
        },
        "events": []
      }
    },
    {
      "at": 6,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "rules": {
          "Gauntlet/1": "active",
          "Gauntlet/2": "waiting"
        },
        "masts": {
          "Left Bridge": "R281",
          "Right Bridge": "R292"
        },
        "holders": {
          "Bridge": "Gauntlet/1"
        }
      }
    },
    {
      "at": 10,
      "do": [
        {
          "sensor": "Bridge",
          "is": "occupied"
        }
      ],
      "expect": {
        "events": [
          {
            "pass": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R292"
        }
      }
    },
    {
      "at": 11,
      "do": [
        {
          "sensor": "Left",
          "is": "clear"
        }
      ]
    },
    {
      "at": 15,
      "do": [
        {
          "sensor": "Bridge",
          "is": "clear"
        }
      ]
    },
    {
      "at": 20,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 25,
      "expect": {
        "rules": {
          "Gauntlet/1": "passed",
          "Gauntlet/2": "waiting"
        }
      }
    },
    {
      "at": 44,
      "expect": {
        "resources": {
          "Bridge": "PASSED"
        },
        "events": []
      }
    },
    {
      "at": 45,
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "release"
          },
          {
            "grant": "Bridge",
            "rule": "Gauntlet/2"
          }
        ],
        "rules": {
          "Gauntlet/1": "waiting",
          "Gauntlet/2": "active"
        },
        "masts": {
          "Left Bridge": "R292",
          "Right Bridge": "R281"
        },
        "holders": {
          "Bridge": "Gauntlet/2"
        }
      }
    }
  ]
}
