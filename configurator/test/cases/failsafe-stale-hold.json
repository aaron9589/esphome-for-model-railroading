{
  "name": "a hold left behind stays at Stop until a manual release clears it",
  "covers": [
    "a stale hold stays at Stop until released"
  ],
  "about": "JMRI held Left Bridge and went away. The hold never expires: the Left train waits. A manual release clears the board's copy of the hold; the mast stays at Stop for that scan and clears the next.",
  "board": {
    "sensors": [
      "Left",
      "Bridge",
      "Right"
    ],
    "masts": {
      "Left Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Right Bridge": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Bridge",
          "blocks": [
            "Bridge"
          ],
          "release": {
            "while": {
              "block": "Bridge",
              "is": "clear"
            },
            "for": "3s"
          }
        }
      ],
      "layers": [
        {
          "name": "Gauntlet",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Left",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Left Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Right",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Right Bridge",
                "aspect": "R281",
                "reserve": "Bridge"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "jmri": "Left Bridge",
          "message": "R281; Lit; Held"
        }
      ]
    },
    {
      "at": 2,
      "do": [
        {
          "sensor": "Left",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 100,
      "expect": {
        "rules": {
          "Gauntlet/1": "waiting"
        },
        "masts": {
          "Left Bridge": "R292"
        },
        "events": []
      }
    },
    {
      "at": 110,
      "do": [
        {
          "release": "Bridge",
          "via": "button"
        }
      ],
      "expect": {
        "events": [
          {
            "release": "Bridge",
            "by": "manual"
          }
        ],
        "masts": {
          "Left Bridge": "R292"
        },
        "rules": {
          "Gauntlet/1": "waiting"
        }
      }
    },
    {
      "at": 111,
      "expect": {
        "events": [
          {
            "grant": "Bridge",
            "rule": "Gauntlet/1"
          }
        ],
        "masts": {
          "Left Bridge": "R281"
        }
      }
    }
  ]
}
