{
  "name": "leaving guard naming resources: only a train that came through them is taken for one leaving, and none clears as it leaves",
  "covers": [
    "a leaving guard that watches the resources it names"
  ],
  "about": "East takes Ahead and Other, and its leaving guard watches only Ahead. A train arrives in Loop while Side holds Other: it is waiting, and goes once Other is free. Later a West train comes through Ahead into Loop: it is taken for one leaving, and East stays at Stop while it stands there and as it leaves. A train that arrives after that is waiting.",
  "board": {
    "sensors": [
      "Loop",
      "In",
      "Side",
      "Ahead",
      "Other"
    ],
    "masts": {
      "East": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "West": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      },
      "Side": {
        "aspects": {
          "R292": "stop",
          "R281": "clear"
        }
      }
    },
    "logic": {
      "resources": [
        {
          "name": "Ahead",
          "blocks": [
            "Ahead"
          ],
          "release": {
            "while": {
              "block": "Ahead",
              "is": "clear"
            },
            "for": "1s"
          }
        },
        {
          "name": "Other",
          "blocks": [
            "Other"
          ],
          "release": {
            "while": {
              "block": "Other",
              "is": "clear"
            },
            "for": "1s"
          }
        }
      ],
      "layers": [
        {
          "name": "East",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Loop",
                  "is": "occupied"
                },
                "for": "0.5s",
                "leavingGuard": [
                  "Ahead"
                ]
              },
              "checks": [],
              "then": {
                "mast": "East",
                "aspect": "R281",
                "reserve": [
                  "Ahead",
                  "Other"
                ]
              }
            }
          ]
        },
        {
          "name": "West",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "In",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "West",
                "aspect": "R281",
                "reserve": "Ahead"
              }
            }
          ]
        },
        {
          "name": "Side",
          "rules": [
            {
              "trigger": {
                "while": {
                  "block": "Side",
                  "is": "occupied"
                },
                "for": "0.5s"
              },
              "checks": [],
              "then": {
                "mast": "Side",
                "aspect": "R281",
                "reserve": "Other"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "at": 1,
      "do": [
        {
          "sensor": "Side",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 6,
      "expect": {
        "events": [
          {
            "grant": "Other",
            "rule": "Side/1"
          }
        ],
        "masts": {
          "Side": "R281"
        }
      }
    },
    {
      "at": 10,
      "do": [
        {
          "sensor": "Loop",
          "is": "occupied"
        }
      ]
    },
    {
      "at": 15,
      "expect": {
        "rules": {
          "East/1": "waiting"
        },
        "masts": {
          "East": "R292"
        }
      }
    },
    {
      "at": 20,
      "do": [
        {
          "sensor": "Other",
          "is": "occupied"
        }
      ],
      "expect": {
        "events": [
          {
            "pass": "Other",
            "rule": "Side/1"
          }
        ],
        "masts": {
          "Side": "R292"
        }
      }
    },
    {
      "at": 22,
      "do": [
        {
          "sensor": "Side",
          "is": "clear"
        }
      ]
    },
    {
      "at": 25,
      "do": [
        {
          "sensor": "Other",
          "is": "clear"
        }
      ]
    },
    {
      "at": 35,
