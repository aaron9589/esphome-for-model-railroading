          }
        ],
        "masts": {
          "East": "R292"
        }
      }
    },
    {
      "at": 42,
      "do": [
        {
          "sensor": "Loop",
          "is": "clear"
        }
      ]
    },
    {
      "at": 45,
      "do": [
        {
          "sensor": "Ahead",
          "is": "clear"
        }
      ]
    },
    {
      "at": 47,
      "do": [
        {
          "sensor": "Other",
