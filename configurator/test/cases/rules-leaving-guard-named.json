        "events": [
          {
            "release": "Other",
            "by": "release"
          },
          {
            "grant": "Ahead",
            "rule": "East/1"
          },
          {
            "grant": "Other",
            "rule": "East/1"
          }
        ],
        "masts": {
          "East": "R281"
        }
      }
    },
    {
