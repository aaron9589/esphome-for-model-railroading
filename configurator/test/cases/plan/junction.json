  "steps": [
    {
      "at": 3,
      "expect": {
        "masts": {
          "Home": "R281",
          "Main exit": "R285",
          "Branch exit": "R281",
          "West": "R285"
        },
        "locks": {
          "P1": false
        }
      }
    },
    {
      "at": 10,
      "do": [
        {
          "turnout": "P1",
          "is": "moving"
        }
      ],
      "expect": {
        "masts": {
          "Home": "R292"
        }
      }
    },
    {
      "at": 30,
      "do": [
        {
          "turnout": "P1",
          "is": "thrown"
        }
      ],
      "expect": {
        "masts": {
          "Home": "R283"
        }
      }
    },
    {
      "at": 40,
      "do": [
        {
          "sensor": "Branch current",
          "is": "occupied"
        }
      ],
      "expect": {
        "masts": {
          "Branch exit": "R292",
          "Home": "R283"
        }
      }
    },
    {
      "at": 41,
      "expect": {
        "masts": {
          "Home": "R286"
        }
      }
    },
    {
      "at": 50,
      "do": [
        {
          "sensor": "Junction current",
          "is": "occupied"
        }
      ],
      "expect": {
        "masts": {
          "Home": "R292"
        },
        "locks": {
          "P1": true
        }
      }
    },
    {
      "at": 60,
      "do": [
        {
          "sensor": "Junction current",
          "is": "clear"
        }
      ],
      "expect": {
        "masts": {
          "Home": "R286"
        },
        "locks": {
          "P1": false
        }
      }
    },
    {
      "at": 70,
      "do": [
        {
          "turnout": "P1",
          "is": "closed"
        },
        {
          "sensor": "Main current",
          "is": "occupied"
        }
      ],
      "expect": {
        "masts": {
          "Main exit": "R292",
          "Home": "R281"
        }
      }
    },
    {
      "at": 71,
      "expect": {
        "masts": {
          "Home": "R285"
        }
      }
    }
  ]
}
