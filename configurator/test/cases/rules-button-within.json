{
 "name": "a button pressed in the last few seconds: Keep at Stop unless",
 "covers": [
  "a moment within a time: a button pressed in the last few seconds holds from its press, counts while it is held down, and a second press starts it again"
 ],
 "about": "Left Bridge is kept at Stop unless Go was pressed in the last 3 seconds, as the track plan's Hold a signal until a button is pressed example writes it, with 3 seconds for the usual 30. A press inside one scan (scan 10) counts at scan 10, so it holds until 3 seconds after it: true to scan 39, false at 40. Held down from scan 50 and let go before scan 70, it was last down at scan 69: false at 99. A second press at 120 starts the 3 seconds again: false at 150, not 140.",
 "board": {
  "sensors": [
   "Left",
   "Bridge"
  ],
  "masts": {
   "Left Bridge": {
    "aspects": {
     "R292": "stop",
     "R281": "clear"
    }
   }
  },
  "logic": {
   "buttons": [
    {
     "name": "Go"
    }
   ],
   "layers": [
    {
     "name": "Left Bridge",
     "rules": [
      {
       "trigger": {
        "while": {
         "block": "Bridge",
         "is": "clear"
        }
       },
       "checks": [],
       "then": {
        "mast": "Left Bridge",
        "aspect": "R281"
       }
      }
     ]
    },
    {
     "name": "Left Bridge rule 1",
     "rules": [
      {
       "trigger": {
        "while": {
         "button": "Go",
         "is": "pressed",
         "within": "3s"
        }
       },
       "checks": [],
       "then": {
        "mast": "Left Bridge",
        "aspect": "R281"
       }
      }
     ]
    }
   ]
  }
 },
