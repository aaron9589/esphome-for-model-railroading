{
  "name": "block signals with Advance Approach: Stop, Approach, Advance Approach, Clear",
  "covers": [
    "block signals: the worked example's four rows; the tumbledown with and without Advance Approach; Approach Diverging behind a diverging aspect, and Approach there when Approach Diverging is not used; a remote next mast going offline leaves Approach; a reversed or moving turnout in a block gives Stop"
  ],
  "about": "A train runs through blocks 1, 2 and 3 and off the end of signalled track (C has only the Approach rule). Behind it, A tumbles down Stop, Approach, Advance Approach, Clear.",
  "board": {
    "sensors": [
      "Blk 1",
      "Blk 2",
      "Blk 3"
    ],
    "masts": {
      "A": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear"
        }
      },
      "B": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear"
        }
      },
      "C": {
        "aspects": {
          "R292": "stop",
          "R285": "approach",
          "ADV_NORM": "advance",
          "R281": "clear"
        }
      }
    },
