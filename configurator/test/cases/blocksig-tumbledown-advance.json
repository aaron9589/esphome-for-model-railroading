              "then": {
                "mast": "B",
                "aspect": "ADV_NORM"
              }
            },
            {
              "trigger": {
                "while": {
                  "block": "Blk 2",
                  "is": "clear"
                }
              },
              "checks": [
                {
                  "mast": "C",
                  "is": [
                    "stop",
