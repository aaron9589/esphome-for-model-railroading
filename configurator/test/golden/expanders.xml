<?xml version="1.0" encoding="UTF-8"?>
<layout-config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jmri.org/xml/schema/layout-4-19-2.xsd">
  <!-- expander-board: MQTT items from the ESPHome for Model Railroading Board Configurator. -->
  <!-- In PanelPro: File > Load table content and panels, then File > Store table content and panels to keep them. -->
  <!-- These topics expect the JMRI MQTT Channel to be "trains/". -->
  <sensors class="jmri.jmrix.mqtt.configurexml.MqttSensorManagerXml">
    <sensor inverted="false">
      <systemName>MSKiama/Up XOver</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSInt 2 East</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSInt 2 West</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSYard 3</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSKiama/Up Loop/Thrown</systemName>
    </sensor>
  </sensors>
  <turnouts class="jmri.jmrix.mqtt.configurexml.MqttTurnoutManagerXml">
    <turnout feedback="ONESENSOR" sensor1="MSKiama/Up Loop/Thrown" inverted="false" automate="Default">
      <systemName>MTKiama/Up Loop</systemName>
    </turnout>
  </turnouts>
</layout-config>
