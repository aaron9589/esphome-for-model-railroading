<?xml version="1.0" encoding="UTF-8"?>
<layout-config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://jmri.org/xml/schema/layout-4-19-2.xsd">
  <!-- gpio-servo-board: MQTT items from the ESPHome for Model Railroading Board Configurator. -->
  <!-- In PanelPro: File > Load table content and panels, then File > Store table content and panels to keep them. -->
  <!-- These topics expect the JMRI MQTT Channel to be "trains/". -->
  <sensors class="jmri.jmrix.mqtt.configurexml.MqttSensorManagerXml">
    <sensor inverted="false">
      <systemName>MSStation Road</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSStation/Loop/Thrown</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSStation/Loop/Locked</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSStation/Siding/Thrown</systemName>
    </sensor>
    <sensor inverted="false">
      <systemName>MSStation/Dock/Thrown</systemName>
    </sensor>
  </sensors>
  <turnouts class="jmri.jmrix.mqtt.configurexml.MqttTurnoutManagerXml">
    <turnout feedback="ONESENSOR" sensor1="MSStation/Loop/Thrown" inverted="false" automate="Default">
      <systemName>MTStation/Loop</systemName>
    </turnout>
    <turnout feedback="ONESENSOR" sensor1="MSStation/Siding/Thrown" inverted="false" automate="Default">
      <systemName>MTStation/Siding</systemName>
    </turnout>
    <turnout feedback="ONESENSOR" sensor1="MSStation/Dock/Thrown" inverted="false" automate="Default">
      <systemName>MTStation/Dock</systemName>
    </turnout>
  </turnouts>
</layout-config>
